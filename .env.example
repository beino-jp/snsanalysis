# Copy to .env; never commit secrets. Demo does not call external services.
DATA_PROVIDER=mock
LLM_PROVIDER=mock
DATABASE_URL=postgresql://reach:reach_local_only@localhost:5432/reach
DEMO_AUTH=true
DEMO_PASSWORD=local-demo
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
# Live mode requires DATA_PROVIDER=apify, LLM_PROVIDER=openai, DEMO_AUTH=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
APIFY_TOKEN=
APIFY_LIKERS_ACTOR=
APIFY_COMMENTS_ACTOR=apify/instagram-comment-scraper
APIFY_PROFILE_ACTOR=apify/instagram-profile-scraper
APIFY_POSTS_ACTOR=apify/instagram-post-scraper
# Keep pinning IDs for a reproducible audit; validate actor schema in P0.
APIFY_ACTOR_BUILD=latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set from your actual provider contract. Empty => estimate unavailable.
APIFY_USD_PER_1000_RESULTS=
LLM_USD_PER_USER=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
# P0 only; explicit paid research budget is mandatory.
P0_POST_URL=
P0_ACTORS=memo23/instagram-likers-scraper,steadyfetch/instagram-post-likers-scraper
P0_MAX_USD=
ALLOWED_EMAILS=
P0_INPUT_OVERRIDES=

# Limited real-data web pilot. Leave disabled until shared auth, pricing and a paid test are reviewed.
LIVE_ANALYSIS_ENABLED=false
# API-only monthly envelope; fixed Cloudflare/Supabase costs must be checked separately.
LIVE_MONTHLY_API_BUDGET_YEN=6000
# Staff-only access to imported individual records and legacy internal APIs.
# Invited users not listed here see the limited analysis aggregate UI.
ADMIN_EMAILS=
